{
  "name": "vrcliveime",
  "productName": "VrcLiveIme",
  "version": "3.0.1",
  "description": "A Japanese/English virtual keyboard and chatbox interface designed for SteamVR overlays to send text to VRChat via OSC.",
  "napi": {
    "binaryName": "vr-overlay-native",
    "targets": [
      "x86_64-pc-windows-msvc"
    ]
  },
  "author": {
    "name": "fuku_2019"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env IS_ELECTRON=true vite\" \"wait-on tcp:5173 && electron . --desktop\"",
    "electron:dev:perf": "concurrently -k \"cross-env IS_ELECTRON=true vite\" \"wait-on tcp:5173 && electron . --desktop --perf-log\"",
    "electron:dev:vr": "concurrently -k \"cross-env IS_ELECTRON=true vite\" \"wait-on tcp:5173 && electron . --vr --perf-log\"",
    "electron:dev:vr:eps": "concurrently -k \"cross-env IS_ELECTRON=true vite\" \"wait-on tcp:5173 && electron . --vr --perf-log --cursor-epsilon=0.005\"",
    "dist": "npm run ime:verify-stage && vite build && electron-builder --win --x64 --publish never && node scripts/verify-ime-package.mjs --app release/win-unpacked",
    "dist:validation": "node scripts/verify-ime-package.mjs --stage .tools/ime-helper-package --development && vite build && electron-builder --win --x64 --publish never && node scripts/verify-ime-package.mjs --app release/win-unpacked --development",
    "ime:verify-stage": "node scripts/verify-ime-package.mjs --stage .tools/ime-helper-package",
    "ime:stage": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/stage-ime-helper.ps1 -Destination .tools/ime-helper-package",
    "test": "vitest",
    "test:run": "vitest run && npm run test:ime-helper",
    "test:ime-helper": "node --test electron/services/ime/tests/*.node-test.mjs",
    "build:native": "napi build --platform --release --manifest-path ./native/Cargo.toml && node scripts/sync-native.cjs",
    "native:check": "cargo clippy --manifest-path ./native/Cargo.toml --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "gl-matrix": "^3.4.4",
    "node-osc": "^11.2.2",
    "react-colorful": "^5.6.1",
    "ws": "^8.19.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.8.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "glob": "^10.4.5",
    "rimraf": "^6.0.1",
    "tar": "^7.5.4"
  },
  "build": {
    "npmRebuild": false,
    "afterPack": "./scripts/afterPack.cjs",
    "asarUnpack": [
      "img/**/*",
      "native/**/*",
      "steamvr/**/*"
    ],
    "publish": null,
    "appId": "io.github.vrcliveime",
    "productName": "VrcLiveIme",
    "extraResources": [{ "from": ".tools/ime-helper-package", "to": "ime-helper/win-x64", "filter": ["**/*"] }],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/assets/ime/mozc/**/*",
      "package.json",
      "LICENSE",
      "Openvr-LICENSE.txt",
      "THIRD_PARTY_NOTICES.md",
      "docs/distribution.md",
      "native/index.node",
      "native/openvr_api.dll",
      "img/**/*",
      "steamvr/**/*",
      "!**/*.test.ts",
      "!**/*.test.tsx",
      "!**/*.test.js",
      "!electron/services/ime/tests/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.png",
      "legalTrademarks": "VrcLiveIme",
      "executableName": "VrcLiveIme",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "VrcLiveIme-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
